# Copy to .env and adjust for the host running the stack.
TASKLITE_IMAGE=adius/tasklite:latest
TASKLITE_API_PORT=7458
TASKLITE_WEB_PORT=3002

# Public TaskLite downstream commit used to build the webapp.
TASKLITE_REF=replace-with-tasklite-commit-sha

# Browser-reachable GraphQL endpoint. Keep this deployment-specific.
TASKLITE_GRAPHQL_URL=http://localhost:7458/graphql

# Host path to the local TaskLite configuration file.
TASKLITE_CONFIG_FILE=./config/tasklite/config.yaml
